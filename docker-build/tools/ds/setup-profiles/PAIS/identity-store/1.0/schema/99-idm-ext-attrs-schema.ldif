#
# Identity type discriminator used by the managed user mappings
# (user.identityType -> fr-idm-identity-type). Carried on fr-ext-attrs
# because the shipped DS 8.1.2 schema has no definition for it.
#
attributeTypes: ( fr-idm-identity-type
  NAME 'fr-idm-identity-type'
  DESC 'Defines the type of identity an entry represents'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  EQUALITY caseIgnoreMatch
  SINGLE-VALUE
  X-STABILITY 'Internal' )
#
# Auxiliary object class carrying the generic fr-attr-* attributes.
# fr-idm-identity-type is included here because the managed user mappings
# already apply fr-ext-attrs and the shipped DS 8.1.2 schema has no
# definition for this attribute.
#
objectClasses: ( fr-ext-attrs
  NAME 'fr-ext-attrs'
  DESC 'Generic extension attributes (frIndexed*/frUnindexed* mappings)'
  SUP top
  AUXILIARY
  MAY ( fr-attr-istr1 $
        fr-attr-istr2 $
        fr-attr-istr3 $
        fr-attr-istr4 $
        fr-attr-istr5 $
        fr-attr-istr6 $
        fr-attr-istr7 $
        fr-attr-istr8 $
        fr-attr-istr9 $
        fr-attr-istr10 $
        fr-attr-istr11 $
        fr-attr-istr12 $
        fr-attr-istr13 $
        fr-attr-istr14 $
        fr-attr-istr15 $
        fr-attr-istr16 $
        fr-attr-istr17 $
        fr-attr-istr18 $
        fr-attr-istr19 $
        fr-attr-istr20 $
        fr-attr-imulti1 $
        fr-attr-imulti2 $
        fr-attr-imulti3 $
        fr-attr-imulti4 $
        fr-attr-imulti5 $
        fr-attr-iint1 $
        fr-attr-iint2 $
        fr-attr-iint3 $
        fr-attr-iint4 $
        fr-attr-iint5 $
        fr-attr-idate1 $
        fr-attr-idate2 $
        fr-attr-idate3 $
        fr-attr-idate4 $
        fr-attr-idate5 $
        fr-attr-str1 $
        fr-attr-str2 $
        fr-attr-str3 $
        fr-attr-str4 $
        fr-attr-str5 $
        fr-attr-multi1 $
        fr-attr-multi2 $
        fr-attr-multi3 $
        fr-attr-multi4 $
        fr-attr-multi5 $
        fr-attr-int1 $
        fr-attr-int2 $
        fr-attr-int3 $
        fr-attr-int4 $
        fr-attr-int5 $
        fr-attr-date1 $
        fr-attr-date2 $
        fr-attr-date3 $
        fr-attr-date4 $
        fr-attr-date5 $
        fr-idm-identity-type )
  X-STABILITY 'Internal' )
#
# Agentic AI attributes missing from the shipped DS 8.1.2 idm-repo schema
#
attributeTypes: ( fr-idm-agent-origin
  NAME 'fr-idm-agent-origin'
  DESC 'Origin of a non-human agent'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  EQUALITY caseIgnoreMatch
  SINGLE-VALUE
  X-STABILITY 'Internal' )
attributeTypes: ( fr-idm-agent-identity-reference
  NAME 'fr-idm-agent-identity-reference'
  DESC 'Identity associated with a non-human agent'
  SYNTAX 1.3.6.1.4.1.36733.2.1.3.12
  EQUALITY nameAndJsonCaseIgnoreJsonIdEqualityMatch
  SINGLE-VALUE
  X-STABILITY 'Internal' )
objectClasses: ( fr-idm-agent-ext-obj
  NAME 'fr-idm-agent-ext-obj'
  DESC 'Extensions for Agentic AI object classes'
  SUP top
  AUXILIARY
  MAY ( fr-idm-agent-origin $
        fr-idm-agent-identity-reference )
  X-STABILITY 'Internal' )
