{
  "realm" : "/",
  "entityType" : "sunIdentityRepositoryService",
  "entityId" : "default/OpenDJ",
  "serviceComponent" : "LDAPv3ForOpenDS",
  "data" : {
    "ldapsettings" : {
      "sun-idrepo-ldapv3-config-connection-mode" : {
        "$string" : "&{am.stores.user.connection.mode|LDAPS}"
      },
      "sun-idrepo-ldapv3-config-authid" : {
        "$string" : "&{am.stores.user.username|cn=Directory Manager}"
      },
      "sun-idrepo-ldapv3-config-ldap-server" : {
        "$list" : "&{am.stores.user.servers|[0]=localhost:50636}"
      },
      "sun-idrepo-ldapv3-config-authpw" : {
        "$string" : "&{am.stores.user.password|password}"
      },
      "sun-idrepo-ldapv3-config-organization_name" : "ou=identities"
    },
    "persistentsearch" : {
      "sun-idrepo-ldapv3-config-psearchbase" : "ou=identities"
    }
  }
}
