#
# Custom schema extension for the PAIS platform deployment.
#
# The IDM repository configuration (repo.ds.json) maps the generic
# frIndexed*/frUnindexed* managed object properties onto the fr-attr-*
# LDAP attributes grouped under the fr-ext-attrs auxiliary object class.
# That schema ships with PingOne Advanced Identity Cloud's directory, but
# is NOT part of a standalone Ping DS 8.1.2 installation, so it is defined
# here. (In ForgeOps the equivalent file is docker/ds/config/schema/99-ext.ldif.)
#
# Also defines three fr-idm-* attributes used by the Agentic AI mappings
# (fr-idm-agent-origin, fr-idm-agent-identity-reference, fr-idm-identity-type)
# which are absent from the DS 8.1.2 idm-repo profile schema, plus an
# auxiliary object class to carry them on agent entries.
#
dn: cn=schema
objectClass: top
objectClass: ldapSubentry
objectClass: subschema
cn: schema
#
# Generic indexed string attributes (frIndexedString1..20)
#
attributeTypes: ( fr-attr-istr1
  NAME 'fr-attr-istr1'
  DESC 'Generic indexed string attribute 1'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  EQUALITY caseIgnoreMatch
  ORDERING caseIgnoreOrderingMatch
  SUBSTR caseIgnoreSubstringsMatch
  SINGLE-VALUE
  X-STABILITY 'Internal' )
attributeTypes: ( fr-attr-istr2
  NAME 'fr-attr-istr2'
  DESC 'Generic indexed string attribute 2'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
