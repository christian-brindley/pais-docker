{
  "name": "01-am",
  "condition": "${matchesWithRegex(request.uri.path, '^/am.*$')}",
  "baseURI": "http://am:8080",
  "handler": {
    "type": "Chain",
    "config": {
      "filters": [
        {
          "type": "HeaderFilter",
          "config": {
            "messageType": "REQUEST",
            "replace": {
              "Host": ["pais.local"],
              "X-Forwarded-Proto": ["https"],
              "X-Forwarded-Host": ["pais.local"],
              "X-Forwarded-Port": ["443"]
            }
          }
        }
      ],
      "handler": "ReverseProxyHandler"
    }
  }
}
